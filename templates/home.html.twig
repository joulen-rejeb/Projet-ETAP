{% extends 'base.html.twig' %}

{% block title %}Liste des Produits et Familles{% endblock %}

{% block body %}
<div class="container mt-5">
    {# Section Familles #}
    <h1 class="mb-4">Liste des catégories de produits</h1>

    <div class="mb-4">
        <a href="{{ path('familles_new') }}" class="btn btn-success">➕ Ajouter une nouvelle famille</a>
    </div>

    <div class="row">
        {% for famille in familles %}
            <div class="col-lg-3 col-6 mb-4">
                <div class="small-box text-bg-primary shadow-sm rounded">
                    <div class="inner">
                        <h3>{{ famille.nameCategory }}</h3>
                        <p>{{ nbProduitsParFamille[famille.idFamilles] ?? 0 }} produits</p>
                    </div>

                    {% if famille.photoFamille %}
                        <img src="{{ asset('uploads/familles/' ~ famille.photoFamille) }}"
                             class="img-fluid"
                             alt="{{ famille.nameCategory }}"
                             style="height: 200px; object-fit: cover; width: 100%;">
                    {% else %}
                        <div style="height: 200px; background: #eee; display: flex; align-items: center; justify-content: center;">
                            <svg class="small-box-icon" fill="currentColor" viewBox="0 0 24 24" width="40" height="40">
                                <path d="M3 4a1 1 0 0 1 1-1h4l2 2h8a1 1 0 0 1 1 1v2H3V4zM3 8h18v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8zm5 3v5h2v-5H8zm4 0v5h2v-5h-2z" />
                            </svg>
                        </div>
                    {% endif %}

                    <div class="small-box-footer d-flex justify-content-between p-2">
                        <a href="{{ path('familles_show', {'id': famille.idFamilles}) }}" class="text-white text-decoration-none">👁 Voir</a>
                        <a href="{{ path('familles_edit', {'id': famille.idFamilles}) }}" class="text-white text-decoration-none">✏️ Modifier</a>
                        <form method="post" action="{{ path('familles_delete', {'id': famille.idFamilles}) }}" onsubmit="return confirm('Supprimer cette famille ?');" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ famille.idFamilles) }}">
                            <button class="btn btn-sm btn-link text-white p-0 border-0" style="text-decoration: none;">🗑 Supprimer</button>
                        </form>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-warning">Aucune famille trouvée.</div>
            </div>
        {% endfor %}
    </div>

    {# Section Produits #}
    <h1 class="mb-4 mt-5">Liste des Produits</h1>

    <div class="text-left mb-4">
        <a href="{{ path('app_produits_new') }}" class="btn btn-success">➕ Ajouter un produit</a>
    </div> 
    
    <div class="row g-4">
        {% for produit in produits %}
            <div class="col-md-4 col-sm-6 col-12">
                <div class="card h-100 shadow-sm">
                    {% if produit.photoProduct %}
                        <img src="{{ asset('uploads/produits/' ~ produit.photoProduct) }}" 
                             class="card-img-top" 
                             alt="{{ produit.nameProduct }}" 
                             style="height: 200px; object-fit: cover; border-bottom: 1px solid #ddd;">
                    {% else %}
                        <div class="d-flex align-items-center justify-content-center bg-secondary text-white" style="height:200px;">
                            <i class="bi bi-box-seam" style="font-size: 3rem;"></i>
                        </div>
                    {% endif %}

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title" style="font-size: 1.5rem; font-weight: 600;">{{ produit.nameProduct }}</h5>
                        <p class="card-text mb-1"><strong>Quantité :</strong> {{ produit.quantity }}</p>
                        <p class="card-text mb-1"><strong>Famille :</strong> {{ produit.familles.nameCategory }}</p>
                        <p class="card-text mb-3"><strong>Emplacement :</strong> {{ produit.emplacement.zone }}</p>

                        <div class="mt-auto d-flex justify-content-end gap-3">
                            <a href="{{ path('app_produits_edit', {id: produit.id}) }}" 
                               class="btn btn-sm btn-warning d-flex align-items-center justify-content-center p-2 rounded shadow-sm"
                               title="Modifier ce produit"
                               style="width: 38px; height: 38px; transition: background-color 0.3s ease;">
                                <i class="bi bi-pencil-fill" style="font-size: 1.2rem;"></i>
                            </a>

                            <form method="post" action="{{ path('app_produits_delete', {id: produit.id}) }}" onsubmit="return confirm('Êtes-vous sûr ?');" class="m-0 p-0">
                                <button type="submit" 
                                        class="btn btn-sm btn-danger d-flex align-items-center justify-content-center p-2 rounded shadow-sm"
                                        title="Supprimer ce produit"
                                        style="width: 38px; height: 38px; transition: background-color 0.3s ease;">
                                    <i class="bi bi-trash-fill" style="font-size: 1.2rem;"></i>
                                </button>
                                <input type="hidden" name="_method" value="DELETE">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <p class="text-center">Aucun produit trouvé.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}