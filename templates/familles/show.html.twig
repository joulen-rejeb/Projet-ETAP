{% extends 'base.html.twig' %}

{% block title %}Détails de la Famille{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Détails de la Famille</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>ID :</th>
                <td>{{ famille.idFamilles }}</td>
            </tr>
            <tr>
                <th>Nom de la catégorie :</th>
                <td>{{ famille.nameCategory }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('familles_index') }}" class="btn btn-secondary">Retour à la liste</a>
    <a href="{{ path('familles_edit', {'id': famille.idFamilles}) }}" class="btn btn-primary">Modifier</a>
    <form method="post" action="{{ path('familles_delete', {'id': famille.idFamilles}) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ famille.idFamilles) }}">
        <button class="btn btn-danger">Supprimer</button>
    </form>
</div>
{% endblock %}
