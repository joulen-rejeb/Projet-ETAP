{% extends 'base.html.twig' %}

{% block title %}Ajouter un Produit{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h4 class="mb-4">Ajouter un Nouveau Produit</h4>

            {{ form_start(form) }}

            <div class="mb-3">
                {{ form_label(form.nameProduct, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.nameProduct, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.nameProduct) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.quantityInitial, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.quantityInitial, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.quantityInitial) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.photoProduct, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.photoProduct, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.photoProduct) }}
            </div>

            <div class="mb-3">
                <label class="form-label">Emplacement</label>
                <input type="text" class="form-control" value="{{ emplacement_nom }}" disabled>
                {{ form_widget(form.emplacement, {'attr': {'class': 'd-none'}}) }}
            </div>


            
           <div class="mb-3">
                {{ form_label(form.familles, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.familles, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.familles) }}
            </div>

            <button type="submit" class="btn btn-outline-dark">Ajouter</button>

            {{ form_end(form) }}

            <div class="mt-3">
                <a href="{{ path('app_produits_index') }}" class="btn btn-link text-decoration-none">
                    ← Retour à la liste
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

