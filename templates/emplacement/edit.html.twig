{% extends 'base.html.twig' %}

{% block title %}Modifier l’Emplacement{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row">
        <div class="col-md-6">
            <h4 class="mb-4">Modifier l’Emplacement</h4>

            {{ form_start(form) }}

            <div class="mb-3">
                {{ form_label(form.zone, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.zone, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.zone) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.name, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.name) }}
            </div>

          <div class="mb-3">
    {{ form_label(form.photoEmplacement, null, {'label_attr': {'class': 'form-label'}}) }}

    {# ✅ Afficher l'image actuelle si elle existe #}
    {% if emplacement.photoEmplacement %}
        <div class="mb-2">
            <p class="mb-1">Image actuelle :</p>
            <img src="{{ asset('uploads/emplacements/' ~ emplacement.photoEmplacement) }}"
                 alt="Image actuelle"
                 class="img-fluid rounded border"
                 style="max-height: 200px;">
        </div>
    {% endif %}

    {{ form_widget(form.photoEmplacement, {'attr': {'class': 'form-control'}}) }}
    {{ form_errors(form.photoEmplacement) }}
</div>


            <button type="submit" class="btn btn-outline-dark">Modifier</button>

            {{ form_end(form) }}

            <div class="mt-3">
                <a href="{{ path('home') }}" class="btn btn-link text-decoration-none">
                    ← Retour à la liste
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
