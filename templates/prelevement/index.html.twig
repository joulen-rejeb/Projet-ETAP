{% extends 'base.html.twig' %}

{% block title %}📦 Historique des prélèvements{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">📜 Historique des prélèvements</h1>
        <a href="{{ path('prelevement_new') }}" class="btn btn-success shadow-sm">
            ➕ Nouveau prélèvement
        </a>
    </div>

    {# Messages flash #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show shadow-sm" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card shadow-lg rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">📅 Date</th>
                        <th scope="col">👤 Responsable</th>
                        <th scope="col">📦 Produits</th>
                    </tr>
                </thead>
                <tbody>
                {% for prelevement in prelevements|reverse %}
                    <tr>
                        <td>
                            <span class="badge bg-secondary">
                                {{ prelevement.requestDate|date('d/m/Y H:i') }}
                            </span>
                        </td>
                        <td>
                            {% set hommes = ['omar', 'ahmed', 'ali'] %}
                            {% if prelevement.user.username in hommes %}
                                👨 Mr <strong>{{ prelevement.user.username }}</strong>
                            {% else %}
                                👩 Mme <strong>{{ prelevement.user.username }}</strong>
                            {% endif %}
                        </td>
                        <td>
                            <ul class="list-unstyled mb-0">
                                {% for produit in prelevement.prelevementProduits %}
                                    <li class="mb-1">
                                        <i class="bi bi-box-seam text-primary"></i> 
                                        {{ produit.produit.nameProduct }}
                                        <span class="badge bg-info ms-2">
                                            {{ produit.quantite }} unités
                                        </span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">
                            Aucun prélèvement enregistré.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}